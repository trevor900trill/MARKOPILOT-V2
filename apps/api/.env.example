# =============================================
# MARKOPILOT V2 — API Environment Variables
# Copy to .env and fill in values
# =============================================

# ── Database ─────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=host.docker.internal;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Prefer

# ── Supabase ─────────────────────────────────────
Supabase__Url=
Supabase__ServiceRoleKey=
Supabase__JwtSecret=

# ── Redis ────────────────────────────────────────
# For local Docker Redis (overrides appsettings)
Redis__ConnectionString=redis:6379,abortConnect=False

# ── AI / Search ──────────────────────────────────
OpenRouter__ApiKey=
Serper__ApiKey=
Exa__ApiKey=
HunterIo__ApiKey=
Replicate__ApiKey=
Creatomate__ApiKey=

# ── Social Integrations ─────────────────────────
Social__X__ClientId=
Social__X__ClientSecret=
Social__LinkedIn__ClientId=
Social__LinkedIn__ClientSecret=
Social__Instagram__ClientId=
Social__Instagram__ClientSecret=
Social__TikTok__ClientKey=
Social__TikTok__ClientSecret=

# ── Payments ─────────────────────────────────────
Mpesa__Environment=sandbox
Mpesa__ShortCode=
Mpesa__ConsumerKey=
Mpesa__ConsumerSecret=
Mpesa__Passkey=
Mpesa__CallbackUrl=http://localhost:5000/api/webhooks/mpesa-callback

Flutterwave__SecretKey=
Flutterwave__WebhookHash=

# ── Email ────────────────────────────────────────
Resend__ApiKey=
Resend__FromEmail=Markopilot Alerts <alerts@markopilot.com>

# ── Google OAuth ─────────────────────────────────
Google__ClientId=
Google__ClientSecret=

# ── Encryption ───────────────────────────────────
Encryption__AesKey=
Encryption__AesIv=

# ── URLs ─────────────────────────────────────────
Api__BaseUrl=http://localhost:5000
Frontend__BaseUrl=http://localhost:3000
